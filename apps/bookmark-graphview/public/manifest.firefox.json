{
    "manifest_version": 3,
    "name": "Start Page",
    "version": "1.0.0",
    "description": "A premium start page for your browser.",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "bookmarks"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "startpage@example.com",
            "strict_min_version": "109.0"
        }
    },
    "background": {
        "scripts": []
    },
    "icons": {
        "16": "vite.svg",
        "48": "vite.svg",
        "128": "vite.svg"
    }
}