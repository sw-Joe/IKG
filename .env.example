# =========================================================================
# IKG Monorepo Environment Configuration Template
# =========================================================================

# 1. Queue Strategy Configuration
# EMBEDDED: Single-process in-memory queue (Default for local MVP, 0MB Redis overhead)
# CELERY: Distributed Celery queue with Redis backend
QUEUE_MODE=EMBEDDED

# 2. Celery & Cache Backend (Required if QUEUE_MODE=CELERY or cache is active)
REDIS_URL=redis://localhost:6379/0

# 3. Storage Layer Paths (Recommended: Use Absolute Paths to prevent CWD breaking)
# 공백으로 두거나 줄을 삭제할 경우, config.py가 자동으로 프로젝트 최상위 루트 기점의 
# 절대 경로(Absolute Path)를 추적하여 하부 폴백 가드레일을 가동합니다.
IKG_DB_PATH=/home/joe/PROJECT/IKG/db/ikg_metadata.db
IKG_INDEX_PATH=/home/joe/PROJECT/IKG/db/ikg_vector.index

# 4. AI Inference Engine Configurations
# ONNX-quantized BGE-M3 모델 파일이 포함된 디렉토리의 절대 혹은 프로젝트 루트 기점 상대 경로
IKG_MODEL_PATH=/home/joe/PROJECT/IKG/model/bge-m3-onnx-int8
# IKG_MODEL_PATH 내부의 실제 정량화 ONNX 바이너리 파일명 명세
IKG_MODEL_FILE=model_quantized.onnx